<Window x:Class="Fonoo.Windows.MiniCallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:desktop="using:Fonoo.Windows.Desktop" Title="Fonoo · Gespräch">
 <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource FonooSurface}" Padding="14" RowSpacing="10">
  <Grid.Resources>
   <Style x:Key="MiniButton" TargetType="Button">
    <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
   </Style>
   <Style x:Key="MiniMuteActive" TargetType="Button" BasedOn="{StaticResource MiniButton}"><Setter Property="Background" Value="{ThemeResource FonooKeyFace}"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="3">
    <TextBlock x:Name="Peer" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="State" FontSize="11" Foreground="{ThemeResource FonooMuted}" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <TextBlock x:Name="Duration" Grid.Column="1" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource FonooPurple}" FontWeight="SemiBold"/>
   <Button Grid.Column="2" Click="OpenClicked" Width="26" Height="26" Padding="4" VerticalAlignment="Top" AutomationProperties.Name="Gespräch in Fonoo öffnen" ToolTipService.ToolTip="Gespräch in Fonoo öffnen">
    <FontIcon Glyph="&#xE8A7;" FontSize="13"/>
   </Button>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="6">
   <TextBlock Text="Gesprächspegel" FontSize="10" Foreground="{ThemeResource FonooMuted}"/>
   <desktop:AudioLevelBar x:Name="LevelMeter" Height="8" AutomationProperties.Name="Gesprächspegel"/>
  </StackPanel>
  <Button x:Name="Answer" Grid.Row="2" Content="Annehmen" Click="AnswerClicked" HorizontalAlignment="Stretch" Height="34" Background="{ThemeResource FonooCallGreen}" Foreground="{ThemeResource FonooCallInk}" AutomationProperties.Name="Anruf annehmen" Visibility="Collapsed"/>
  <Grid Grid.Row="3" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
   <Button x:Name="Mute" Click="MuteClicked" Style="{StaticResource MiniButton}" AutomationProperties.Name="Mikrofon stummschalten">
    <Grid Width="18" Height="18"><FontIcon Glyph="&#xE720;" FontSize="18"/><TextBlock x:Name="MuteSlash" Text="/" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0" Visibility="Collapsed"/></Grid>
   </Button>
   <Button x:Name="Hold" Grid.Column="1" Click="HoldClicked" Style="{StaticResource MiniButton}" AutomationProperties.Name="Gespräch halten"><FontIcon x:Name="HoldIcon" Glyph="&#xE769;" FontSize="17"/></Button>
   <Button Grid.Column="2" Style="{StaticResource MiniButton}" AutomationProperties.Name="Weitere Gesprächsaktionen" ToolTipService.ToolTip="Weitere Aktionen">
    <FontIcon Glyph="&#xE712;" FontSize="18"/>
    <Button.Flyout>
     <MenuFlyout>
      <MenuFlyoutItem x:Name="Keypad" Text="Tastenfeld" Click="KeypadClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem x:Name="Transfer" Text="Weiterleiten / Rückfrage" Click="TransferClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F2;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem Text="Gespräch in Fonoo öffnen" Click="OpenClicked"/>
     </MenuFlyout>
    </Button.Flyout>
   </Button>
   <Button x:Name="End" Grid.Column="3" Click="EndClicked" Style="{StaticResource MiniButton}" Background="{ThemeResource FonooCallDanger}" Foreground="{ThemeResource FonooCallInk}" AutomationProperties.Name="Auflegen">
    <SymbolIcon Symbol="Phone" RenderTransformOrigin=".5,.5"><SymbolIcon.RenderTransform><RotateTransform Angle="135"/></SymbolIcon.RenderTransform></SymbolIcon>
   </Button>
  </Grid>
  <Grid x:Name="ConsultationActions" Grid.Row="4" ColumnSpacing="8" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="Complete" Content="Verbinden" Click="CompleteClicked" Style="{StaticResource MiniButton}" AutomationProperties.Name="Gespräche verbinden"/>
   <Button x:Name="ReturnOriginal" Grid.Column="1" Content="Zurück" Click="ReturnClicked" Style="{StaticResource MiniButton}" AutomationProperties.Name="Zurück zum gehaltenen Gespräch"/>
  </Grid>
 </Grid>
</Window>
